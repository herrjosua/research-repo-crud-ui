PORT=3001
SESSION_SECRET=replace-with-a-long-random-string
AGENTIC_REPO_ROOT=/absolute/path/to/your/agentic-repo/checkout
PYTHON_BIN=/absolute/path/to/your/agentic-repo/.venv/bin/python3
DEMO_MODE=false
# Ask the Repo (POST /api/ask). Leave LLM_PROVIDER unset to switch it off.
# "ollama": live answers, fully local, via Ollama's HTTP API. "static":
# the public demo's pre-generated answers, no model needed.
LLM_PROVIDER=ollama
# Optional overrides (these are the defaults):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=gemma2:9b
# The chat model's seed for live answers, so the same question on the same
# corpus gets the same text (same hardware and Ollama version only). Unset
# or empty means 42; "random" sends no seed, to see answers vary. Anything
# else that isn't an integer refuses to start.
# ASK_SEED=42
# LLM_PROVIDER=bedrock answers with Amazon Bedrock (see README.md). It still
# needs Ollama for the embeddings (OLLAMA_BASE_URL, OLLAMA_EMBED_MODEL).
# Credentials come from the AWS SDK's default chain through AWS_PROFILE;
# never put AWS keys in this file. ASK_SEED doesn't apply (no seed).
# AWS_PROFILE=
# BEDROCK_MODEL_ID=
# BEDROCK_REGION=us-east-1
# BEDROCK_MAX_TOKENS=4096
# BEDROCK_EFFORT=high
# NODE_ENV=development: this is a local dev server. It also decides whether
# DEV_TOOLS_ENABLED can take effect: the dev-only routes are registered only
# when NODE_ENV is development or test, never production.
# DEV_TOOLS_ENABLED=true adds the Ask page's dev-only provider toggle
# (POST /api/dev/provider): switch between static and ollama without a
# restart. Off by default; ignored (with a warning saying why) unless
# NODE_ENV is development or test. See README.md.
NODE_ENV=development
DEV_TOOLS_ENABLED=false
