# Production settings for the webhost (run through the host's process
# manager). Copy to backend/.env
# on the server and fill in the placeholders. Never commit the real file.
#
# Traffic: browser -> Cloudflare (HTTPS, proxied) -> host proxy (80/443)
# -> this app over plain HTTP. One Node process serves the API and the built
# frontend (frontend/dist, built before deploying).

NODE_ENV=production

# The port the process manager assigned to this app. It does not pass it in
# as an environment variable, so it has to be set here. The app listens on it
# without binding a specific host.
PORT=26851

# Signs session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# true shows the demo-user picker and disables self-signup.
DEMO_MODE=true

# The agentic-repo checkout the app reads, edits and commits to.
AGENTIC_REPO_ROOT=/absolute/path/to/your/agentic-repo/checkout

# Python with agentic-repo's requirements.txt installed.
PYTHON_BIN=/absolute/path/to/your/agentic-repo/.venv/bin/python3
# Stops Python writing __pycache__/ into the repo (the app also sets this for
# the scripts it runs).
PYTHONDONTWRITEBYTECODE=1

# Committer identity for the commits the app makes in AGENTIC_REPO_ROOT. Each
# commit's author is the logged-in user; git still needs a committer, and the
# hosting account likely has no git identity configured.
GIT_COMMITTER_NAME=Research Repo CRUD UI
GIT_COMMITTER_EMAIL=replace-with-a-committer-email@example.com

# Hostname(s) the app answers for, comma separated. Anything else gets 421.
# Host is client-controlled, so this isn't access control; it keeps the app
# from acting on a hostname it doesn't own.
ALLOWED_HOSTS=ux-research.joshuabock.com

# Address(es) of the host's own proxy, comma separated (Express also accepts
# loopback, linklocal, uniquelocal). Cloudflare's published ranges are always
# trusted in addition (backend/proxyTrust.js). If req.ip or login looks wrong,
# log req.socket.remoteAddress once to see the host proxy's real address.
TRUST_PROXY=loopback

# Keep false: Cloudflare's edge Redirect Rule already enforces HTTPS. Only
# enable the app's own redirect once Cloudflare SSL is Full (strict) with an
# origin certificate; before that it can report plain HTTP to the app and
# cause a redirect loop.
HTTPS_REDIRECT=false

# Optional: where the built frontend lives. Defaults to ../frontend/dist
# relative to backend/; the app refuses to start if it has no index.html.
# FRONTEND_DIST=/absolute/path/to/your/checkout/frontend/dist
