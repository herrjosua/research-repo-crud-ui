# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment / secrets
.env
.env.local
.env.*.local
backend/.env

# Databases (SQLite files — content lives in markdown, this is just user/session data)
*.db
*.db-journal
*.db-wal
*.db-shm
app.test.*.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS junk
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/
*.swp

# Playwright output (the HTML report is only written in CI)
e2e/test-results/
e2e/playwright-report/

# Build output (once frontend exists)
frontend/dist/
frontend/build/

# scripts/deploy.sh's staged build and rollback copies on the server
frontend/dist.next/
frontend/dist.prev/
backend/node_modules.prev/

# Stray venv, in case IntelliJ created one despite this being a Node project
.venv/

# Local curl testing artifacts (contains live session cookies)
cookies.txt

# Backup safety net for docs/deploy.md's key rotation steps, which generate
# these under ~/.ssh — not here — but in case one ever lands in the repo:
github-actions-deploy*
host-key.pub